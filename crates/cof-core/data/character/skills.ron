// Skill descriptions (p.16-18), keyed by Skill.
{
    Athlete: "You have +2 Mastery on all checks involving athleticism (swimming, running, etc.).",
    BattleFrenzy: "As a Free Action, you gain +2 Mastery to all attack checks, are immune to Frightened, but your DR is reduced by 2. This lasts for 5 rounds.",
    Brace: "Once per combat, you can make a Hard STR check to ignore all damage from a single source. This is a Reaction.",
    BruteForce: "Gain a +2 Mastery when making checks for breaking objects, doors, or barriers.",
    GrapplingMastery: "Gain Advantage on all wrestling or grappling rolls.",
    HeavyLifting: "Increase your Carrying Capacity by 5.",
    Intimidation: "You may add your STR modifier in the form of Mastery to all PRE checks involving intimidation.",
    MightyLeap: "Double the distance you can jump horizontally or vertically.",
    PowerStrikes: "Your melee attacks always deal Bludgeoning damage, regardless of the weapon you're using, in addition to the weapon's default damage type. When dealing a Major Injury with a melee weapon, you can choose to roll on the Bludgeoning Damage table, or the weapon's default one.",
    TwoHandedWeaponMastery: "Gain +2 Mastery to attack checks with two-handed weapons.",
    EndlessStamina: "You are immune to Fatigued.",
    Fortitude: "Gain +2 Mastery to Endurance checks.",
    Hardy: "Gain +2 Mastery to checks against environmental hazards (e.g., extreme heat or cold).",
    IronStomach: "Gain +2 Mastery to checks against poisons or spoiled or toxic food/drink.",
    PainTolerance: "When you would receive a Minor Injury, make a Hard CON check. If successful, you don't suffer a Minor Injury. This can only happen once per round.",
    PoisonResistance: "Gain +2 Mastery on checks against poison.",
    QuickRecovery: "Double the Trauma loss rate resting.",
    Tough: "When calculating Trauma after a fight, gain 1 less.",
    Unbreakable: "Gain +1 DR.",
    Vigorous: "Increase your Vigor by +1.",
    Acrobatics: "Gain +2 Mastery to checks related to acrobatic maneuvers (e.g., balancing, tumbling).",
    Ambusher: "Deal an automatic Minor Injury when attacking a target unaware of your presence.",
    Evasion: "Gain +2 Mastery to checks against area effects or traps.",
    Lockpicking: "Gain +2 Mastery to checks for opening locks.",
    NimbleFingers: "Gain +2 Mastery to checks when attempting to pickpocket something or dismantle a trap.",
    PrecisionStrikes: "Gain +2 Mastery to attack checks with ranged or finesse weapons.",
    QuickDraw: "Gain +2 Initiative.",
    Stealth: "Gain +2 Mastery to checks for moving silently or hiding.",
    TwoHandMastery: "Gain +2 Mastery to attack checks when wielding two weapons.",
    VaultAndShoot: "As a Standard Action, you make an Easy DEX check to disengage from combat, move 1 square backwards, and immediately make an attack with -2 Burden. Intelligence",
    Healing: "Gain +2 Mastery to checks related to healing.",
    Investigation: "Gain +2 Mastery to checks related to finding hidden clues or secrets.",
    LipReading: "You can read lips.",
    LoreMastery: "Gain +2 Mastery to checks related to recalling obscure or ancient knowledge.",
    Naturalism: "Gain +2 Mastery to checks related to common plant and animal life forms.",
    Navigation: "Gain +2 Mastery to all checks related to finding your position and the desired path forward.",
    Perception: "Gain +2 Mastery to checks related to general perception and awareness.",
    PuzzleSolving: "Gain +2 Mastery to checks for solving riddles or complex mechanisms.",
    Tactics: "Gain +2 Mastery to checks related to planning and executing strategies in combat.",
    Theology: "Gain +2 Mastery to checks related to religion and spirituality.",
    Calm: "Whenever you must make an Anguish Check, increase the die roll by +2.",
    Empathic: "Your max Humanity is increased by 2.",
    Insight: "Gain +2 Mastery when making a check in order to read someone's intentions or emotions.",
    InnerStrength: "Gain +2 Mastery to checks against supernatural effects.",
    MentalFortitude: "Gain +2 Mastery to checks against fear, charm, or mind-affecting effects.",
    MindOverMatter: "Gain +2 Mastery to checks related to enduring physical pain or exhaustion.",
    PsychicResistance: "Gain +2 DR when defending against Primordial Damage.",
    SoulResistance: "Gain +2 DR when defending against Divine Damage.",
    SelfReflection: "Once per day, you can spend 1 hour while at camp thinking about the day's events, which grants you +5 XP.",
    SuppressTheChange: "You can ignore the negative effects of a single Blessing of the Flesh. You can take this Skill multiple times.",
    Awe: "Gain +2 Mastery to checks that involve inspiring fear or admiration through sheer presence.",
    Bluff: "Gain +2 Mastery to checks that involve deceiving or misleading others.",
    Charm: "Gain +2 Mastery to checks that involve influencing others through charisma and persuasion.",
    Command: "Gain +2 Mastery to checks that involve directing allies in combat.",
    Diplomacy: "Gain +2 Mastery to checks that involve negotiating favorable outcomes in social situations.",
    Haggling: "Gain +2 Mastery to checks that involve negotiating prices and conditions.",
    Intimidating: "Whenever a creature targets you in combat, they will target one of your allies instead.",
    Leadership: "Gain +2 Mastery to checks that involve inspiring followers and giving orders.",
    Networking: "You only need 24 hours in a new settlement to recognize the basic power dynamics and important players.",
    Performance: "Gain +2 Mastery to checks that involve interpreting a role, for entertainment purposes or otherwise.",
}
